# Keep this server-side. Never prefix it with NEXT_PUBLIC_.
SARVAM_API_KEY=sk_your_key_here
SARVAM_MODEL=sarvam-105b

# Local DuckDB path. The application always opens this file read-only.
DUCKDB_PATH=./data/moveinsync.duckdb

# Optional: override dashboard assumptions.
OTA_GRACE_MINUTES=15
OTA_SLA_PERCENT=90

